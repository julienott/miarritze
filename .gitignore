# Sauvegardes des sheets de combattants avant nettoyage procédural
# (voir tools/sprites/clean_alpha.py). Les .orig restent en local pour
# pouvoir rejouer un nettoyage ; la vérité versionnée est la sheet nettoyée.
assets/fighters/*/sheet.orig.png
assets/fighters/*/sheet.orig.png.import

# Service /producer : données serveur et jeton local de l'agent (jamais versionnés)
producer/data/
.producer_token
.pf_token
backend/turn.php
tools/gordeka/.decor_go
