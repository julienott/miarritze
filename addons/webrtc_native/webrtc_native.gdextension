; godotengine/webrtc-native 1.2.2-stable (licence MIT, voir LICENSE.*) : WebRTC hors navigateur
; (Steam Deck, Recalbox, Mac). Le web utilise le WebRTC du navigateur (exclude_tags).
; Seules les plateformes du jeu sont gardées ; changer de version = relever RUNTIME_TAG
; (src/autoload/updater.gd) et WEBRTC_TAG (.github/workflows/deploy.yml).
[configuration]

entry_symbol = "webrtc_extension_init"
compatibility_minimum = 4.3

exclude_tags = ["web", "no-webrtc"]

[libraries]

macos.debug = "lib/libwebrtc_native.macos.template_debug.universal.framework"

linux.release.x86_64 = "lib/libwebrtc_native.linux.template_release.x86_64.so"
linux.release.arm64 = "lib/libwebrtc_native.linux.template_release.arm64.so"
macos.release = "lib/libwebrtc_native.macos.template_release.universal.framework"
