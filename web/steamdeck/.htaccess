# /steamdeck/ — page d'installation et paquets de la version Steam Deck.
# Hérite des en-têtes du .htaccess racine (COOP/COEP, no-cache).

<IfModule mod_mime.c>
	# Servis tels quels, sans Content-Encoding : sinon un client décompresserait
	# l'archive au vol et l'empreinte sha256 ne correspondrait plus.
	RemoveEncoding .gz
	AddType application/gzip .gz
	AddType application/octet-stream .pck
	AddType text/x-shellscript .sh
	AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
	# Le script et les paquets se téléchargent au lieu de s'afficher.
	<FilesMatch "\.(sh|pck|gz)$">
		Header set Content-Disposition "attachment"
	</FilesMatch>
</IfModule>
