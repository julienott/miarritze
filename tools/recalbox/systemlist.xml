<?xml version="1.0" encoding="utf-8"?>
<!--
  Miarritze Borroka pour Recalbox : système « miarritze », rangé dans Ports.
  À placer dans share/system/.emulationstation/systemlist.xml (fichier
  utilisateur, lu par EmulationStation en plus de la liste de Recalbox).
  S'il existe déjà, n'y ajouter que le bloc <system> ci-dessous.
  Le jeu est le lanceur roms/ports/miarritze/MiarritzeBorroka.sh, exécuté
  par la commande « bash %ROM% » (pas d'émulateur ; l'émulateur et le cœur
  déclarés ne servent qu'à satisfaire EmulationStation).
-->
<systemList>
  <system uuid="3aad7373-5176-4fcb-942e-6584ba8b44c4" name="miarritze" fullname="Miarritze Borroka">
    <descriptor path="%ROOT%/ports/miarritze" theme="ports" extensions=".sh" command="bash %ROM%" icon="$0" port="1" readonly="0"/>
    <scraper screenscraper="0"/>
    <properties type="port" pad="mandatory" keyboard="optional" mouse="no" releasedate="2026-10" lightgun="0" crt.multiresolution="0" crt.multiregion="0"/>
    <emulatorList>
      <emulator name="miarritze">
        <core name="miarritze" priority="1" extensions=".sh" netplay="0" compatibility="high" speed="high"/>
      </emulator>
    </emulatorList>
  </system>
</systemList>
