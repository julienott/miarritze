; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Miarritze Borroka"
run/main_scene="res://src/ui/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Settings="*res://src/autoload/settings.gd"
Profiles="*res://src/autoload/profiles.gd"
Api="*res://src/autoload/api.gd"
InputHub="*res://src/autoload/input_hub.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
QaCapture="*res://src/autoload/qa_capture.gd"
OrientationOverlay="*res://src/autoload/orientation_overlay.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/handheld/orientation=4
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[gui]

theme/custom="res://assets/ui/theme.tres"

