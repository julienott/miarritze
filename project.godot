; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Miarritze Gordeka"
run/main_scene="res://src/gordeka/gk_boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/app_icon.png"

[autoload]

Updater="*res://src/autoload/updater.gd"
QuitCombo="*res://src/input/quit_combo.gd"
Settings="*res://src/autoload/settings.gd"
Profiles="*res://src/autoload/profiles.gd"
Api="*res://src/autoload/api.gd"
InputHub="*res://src/autoload/input_hub.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
QaCapture="*res://src/autoload/qa_capture.gd"
OrientationOverlay="*res://src/autoload/orientation_overlay.gd"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode.steamdeck=3
window/size/mode.recalbox=3
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

